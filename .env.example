# ─────────────────────────────────────────────────────────────
# Volleyball Training — орчны хувьсагчид
# Энэ файлыг .env болгож хуулаад утгуудыг бөглөнө үү.
# .env файлыг git-д ХЭЗЭЭ Ч оруулахгүй (.gitignore-д бүртгэлтэй).
# ─────────────────────────────────────────────────────────────

# ── 1. Өгөгдлийн сан (Supabase PostgreSQL) ───────────────────
# Supabase Dashboard → төслөө сонго → дээд талын "Connect" товч
# → "ORMs" эсвэл "Connection string" таб.
#
# АППЛИКЕЙШНД (Transaction pooler, порт 6543 — IPv4 дэмжинэ):
#   Connect → Transaction pooler → URI
#   Жишээ:
#   postgresql://postgres.abcdefghijklm:ТАНЫ-DB-НУУЦ-ҮГ@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.<project-ref>:<DB-PASSWORD>@<region>.pooler.supabase.com:6543/postgres"

# MIGRATION-Д (Session pooler, порт 5432 — DDL найдвартай ажиллана):
#   Connect → Session pooler → URI
#   Хоосон орхивол DATABASE_URL-ийг ашиглана.
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<DB-PASSWORD>@<region>.pooler.supabase.com:5432/postgres"

# <DB-PASSWORD> = Supabase → Project Settings → Database → "Database password".
#
# Нууц үгийг гараар бичихийн оронд дараах командыг ашиглавал тусгай тэмдэгтийг
# (@ : / ? # & % + зай г.м.) автоматаар URL-encode хийж, дэлгэцэнд хэвлэлгүйгээр бичнэ:
#
#   npm run db:set-password
#   npm run db:check          # холболтоо шалгах (өгөгдөл өөрчлөхгүй)

# SSL: Supabase-д автоматаар асна. Локал PostgreSQL дээр унтраахыг хүсвэл:
# DATABASE_SSL="disable"

# Сервер суулгахгүйгээр туршихад (файлд суурилсан WASM PostgreSQL):
# DATABASE_URL="pglite://./.pglite"

# ── 2. Session ───────────────────────────────────────────────
# Session token-ыг DB-д хадгалахын өмнө энэ түлхүүрээр HMAC хийнэ (заавал, 32+ тэмдэгт).
# Солих юм бол бүх хэрэглэгч дахин нэвтэрнэ.
# Дор хаяж 32 тэмдэгт санамсаргүй утга:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="ЭНД_САНАМСАРГҮЙ_УРТ_ТҮЛХҮҮР_ТАВЬ"

# ── 3. Анхны админ (npm run create-admin) ───────────────────
# Заавал биш — командыг аргументгүй ажиллуулбал утгыг асууна.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Админ"

# ── 4. Бусад ─────────────────────────────────────────────────
# Demo seed-ийг production дээр ажиллуулахыг зөвшөөрөх (зөвхөн туршилтад)
ALLOW_SEED_IN_PRODUCTION="false"

# Холболтын pool-ийн дээд хэмжээ (заавал биш)
# DATABASE_POOL_MAX="5"
